{
  "name": "toobler-one",
  "private": true,
  "version": "0.0.0",
  "description": "Toobler One: AI Business Operations Platform",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @toobler-one/api\" \"npm run dev -w @toobler-one/web\"",
    "build": "npm run build -w @toobler-one/web",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "e2e": "playwright test",
    "gate": "node scripts/gate.mjs",
    "vet": "node scripts/vet-packages.mjs",
    "audit:deps": "npm audit --audit-level=high && npm audit signatures",
    "verify": "npm run gate && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
