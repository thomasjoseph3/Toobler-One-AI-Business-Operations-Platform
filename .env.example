# Copy to .env (npm run setup does this if .env is missing). Names only; real values never go in git.

# The development database (Postgres 17). Our tables live in the "app" schema.
DATABASE_URL=
# off | require | verify (use require for Supabase)
DATABASE_SSL=require
# Max connections this process opens (Supabase session pooler allows 15 across all processes)
DATABASE_POOL_SIZE=6

PORT=4000
LOG_LEVEL=info
# Where the staff app and the API are reached from
WEB_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
# DEVELOPMENT ONLY: where the API docs page (/docs) runs, so "Try it out" is allowed to change data. Ignored outside
# development; the app refuses to start in production if this is set.
API_DOCS_ORIGIN=http://localhost:4000
# Which proxies may set X-Forwarded-For: loopback | none | a comma list of IPs
TRUST_PROXY=loopback

# Signs the sign-in tokens. At least 32 characters. `npm run setup` adds a random one to your .env if it is missing.
# Never share it, never commit it; changing it signs everyone out.
JWT_SECRET=
# Optional: how long an access token works (minutes) and how long a sign-in lasts at most (days). Defaults shown.
# ACCESS_TOKEN_MINUTES=15
# SESSION_MAX_DAYS=
# SESSION_IDLE_DAYS=  (a sign-in nobody has refreshed for this many days ends; default 7)30

# Email. MAIL_PROVIDER is smtp (send through a real mail server) or console (print the email in the API's terminal, for
# development). Left empty it is smtp when SMTP_HOST is set, otherwise console. Production must use smtp.
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The From line of every email, like: Toobler One <no-reply@yourdomain.com>
EMAIL_FROM=

# The platform's own AI keys (used for demos). Each can hold one key or several separated by commas; the app rotates through
# them. Leave a provider empty to switch it off. Never share or commit these.
GEMINI_API_KEYS=
OPEN_AI_API_KEY=
CLAUDE_API_KEY=

# Scrambles the AI keys that businesses save (AES-256-GCM): 32 random bytes in base64. `npm run setup` adds one to your .env if it
# is missing. Back it up: if it is lost, every saved business key becomes unreadable and must be entered again. Never share it.
SECRETS_ENCRYPTION_KEY=

# Tests only: a LOCAL Postgres (npm run db:up). The test setup refuses any other host.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/toobler_test
