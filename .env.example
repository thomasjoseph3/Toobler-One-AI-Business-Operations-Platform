# Copy to .env (npm run setup does this if .env is missing). Names only; real values never go in git.

# The development database (Postgres 17). Our tables live in the "app" schema.
DATABASE_URL=
# off | require | verify (use require for Supabase)
DATABASE_SSL=require
# Max connections this process opens (Supabase session pooler allows 15 across all processes)
DATABASE_POOL_SIZE=6

PORT=4000
LOG_LEVEL=info
# Where the staff app and the API are reached from
WEB_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
# Which proxies may set X-Forwarded-For: loopback | none | a comma list of IPs
TRUST_PROXY=loopback

# Signs the sign-in tokens. At least 32 characters. `npm run setup` adds a random one to your .env if it is missing.
# Never share it, never commit it; changing it signs everyone out.
JWT_SECRET=
# Optional: how long things last. Defaults shown.
# ACCESS_TOKEN_MINUTES=15
# SESSION_IDLE_DAYS=7
# SESSION_MAX_DAYS=30

# Email (sign-up verification, password reset). With SMTP_HOST set, emails are really sent; without it, the links are
# printed in the API log instead. SMTP_PASS is a secret.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Toobler One <no-reply@example.com>"
# smtp | console (default: smtp when SMTP_HOST is set)
# MAIL_PROVIDER=console
# Country code added to mobile numbers typed without one (91 = India)
# DEFAULT_COUNTRY_CODE=91

# Tests only: a LOCAL Postgres (npm run db:up). The test setup refuses any other host.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/toobler_test
